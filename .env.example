COMPOSE_PROJECT_NAME=personal-finance-app

# Application
APP_ENV=dev
LOG_LEVEL=INFO

# Database
# Required by Docker Compose. Generate a unique, URL-safe value before startup.
POSTGRES_USER=finance
POSTGRES_PASSWORD=
POSTGRES_DB=finance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Used when the API is started directly on the host. Replace CHANGE_ME with
# the same URL-encoded password.
DATABASE_URL=postgresql+psycopg://finance:CHANGE_ME@localhost:5432/finance

# API
API_HOST=127.0.0.1
API_PORT=8000
API_DOCS_ENABLED=false
API_TRUSTED_HOSTS=localhost,127.0.0.1,api
WEB_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]

# UI proxy (used by a locally started Next.js app)
API_URL=http://localhost:8000

# Auth (HTTP Basic, single-user). Leave both empty to disable.
AUTH_USERNAME=
AUTH_PASSWORD=

# Set true only when the browser reaches the application over HTTPS.
APP_LOCK_COOKIE_SECURE=false

# LLM (Ollama on the host machine).
# Docker Compose: host.docker.internal. API started on the host: localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
LLM_ENABLED=true
# Category fallback requires this switch and use_llm_fallback=true per request.
LLM_FALLBACK_ENABLED=false

# CORS — comma-separated origins allowed to call the API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Per-IP rate limit (requests/min). Set to 0 to disable.
RATE_LIMIT_PER_MINUTE=120
