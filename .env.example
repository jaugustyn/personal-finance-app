COMPOSE_PROJECT_NAME=personal-finance-app

# Application
APP_ENV=dev
LOG_LEVEL=INFO

# Database
# WARNING: change POSTGRES_PASSWORD before exposing the DB outside localhost.
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance

# API
API_HOST=0.0.0.0
API_PORT=8000

# UI
API_BASE_URL=http://localhost:8000

# Auth (HTTP Basic, single-user). Leave both empty to disable.
AUTH_USERNAME=
AUTH_PASSWORD=

# LLM (Ollama on the host machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
LLM_ENABLED=true

# Scheduler (in-process APScheduler). Daily classifier retrain.
SCHEDULER_ENABLED=false
RETRAIN_CRON_HOUR=3
RETRAIN_CRON_MINUTE=0
RETRAIN_ESTIMATOR=linear_svc_calibrated

# CORS — comma-separated origins allowed to call the API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Per-IP rate limit (requests/min). Set to 0 to disable.
RATE_LIMIT_PER_MINUTE=120
