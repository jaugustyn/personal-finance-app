FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
COPY apps ./apps

RUN pip install --upgrade pip && pip install -e ".[ui]"

EXPOSE 8501
CMD ["streamlit", "run", "apps/ui/Home.py", "--server.port=8501", "--server.address=0.0.0.0"]
